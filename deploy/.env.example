# 이 파일을 복사해 deploy/.env로 저장하고 실제 값을 채운 뒤 VM에서 사용할 것.
# deploy/.env는 git에 커밋하지 않는다 (루트 .gitignore가 자동으로 제외함).

# Cloudflare Zero Trust 대시보드 → Networks → Tunnels → (터널 생성) → Docker 설치 방법에서 발급되는 토큰.
# 이 토큰이 있으면 cloudflared가 알아서 아웃바운드로 Cloudflare에 연결한다(포트포워딩/공인 IP 불필요).
CLOUDFLARE_TUNNEL_TOKEN=

# docker-compose.yml의 postgres 서비스에 그대로 전달됨
DB_NAME=woori_library
DB_USER=app
DB_PASSWORD=

# backend 컨테이너에 그대로 전달됨(env_file은 변수 치환이 안 되므로 DB_NAME과 같은 값을 literal로 적을 것)
DB_URL=jdbc:postgresql://postgres:5432/woori_library

# AES-256 키(base64, 32바이트). 생성: openssl rand -base64 32
# 로컬 .env와 다른 값을 쓰면 기존에 저장된 도서관 계정 비밀번호를 복호화할 수 없다(재등록 필요).
LIBRARY_PW_ENC_KEY=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# VAPID 키(웹 푸시). 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ehjeong83@gmail.com

# 프론트(Vercel) 배포 도메인. OAuth 로그인 성공 리다이렉트 + CORS 허용 origin으로 쓰인다.
# 끝에 슬래시(/) 없이 정확히 일치해야 한다.
APP_FRONTEND_BASE_URL=
