# 이 파일을 복사해 .env로 저장하고 실제 값을 채운 뒤 사용할 것. .env는 git에 커밋하지 않는다.

# 프론트 배포 도메인(https). 로컬은 비워두면 http://localhost:5173 기본값 사용.
# OAuth 로그인 성공 리다이렉트 + CORS 허용 origin으로 쓰인다.
APP_FRONTEND_BASE_URL=

DB_URL=jdbc:postgresql://localhost:5432/woori_library
DB_USER=app
DB_PASSWORD=app

# AES-256 키(base64, 32바이트). 생성: openssl rand -base64 32
LIBRARY_PW_ENC_KEY=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# VAPID 키(웹 푸시). 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# 프론트엔드 빌드에 노출되는 값 — VAPID_PUBLIC_KEY와 동일한 값을 그대로 사용
VITE_VAPID_PUBLIC_KEY=
